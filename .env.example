# Required for live Upstox market data, fundamentals and news.
# Prefer the Upstox Analytics Token for a long-lived read-only dashboard token.
UPSTOX_ACCESS_TOKEN=

# Optional OAuth login support.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://YOUR-RENDER-SERVICE.onrender.com/callback

PORT=3000
